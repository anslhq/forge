  "implementationNotes": {
    "shadcn": {
      "style": "base-maia",
      "useCssVariables": true,
      "preserveRadiusScale": {
        "none": "0rem",
        "sm": "0.375rem",
        "md": "0.5rem",
        "lg": "0.625rem",
        "xl": "0.875rem",
        "2xl": "1.125rem",
        "3xl": "1.375rem",
        "4xl": "1.625rem",
        "full": "9999px"
      },
      "replaceOnlyColorVariables": "true",
      "keepCurrentThemeInlineRadiusAliases": "true",
      "gradientVariablesAdded": true,
      "gradientUsage": "Expose gradients as custom properties only; do not force them into the base shadcn semantic color slots."
    },
    "supernova": {
      "tokenBlocks": [
        "Design tokens",
        "Color ramps",
        "Accessibility color grid",
        "Themed design tokens"
      ],
      "notes": "Use token groups instead of individual token sprawl; theme values should override semantic tokens, not raw tokens.",
      "gradientNotes": "Use gradient tokens only at semantic and component level; keep hero, aura, and support gradients distinct. Document usage with previews to prevent decorative misuse."
    }
  }
